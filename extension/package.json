{
  "name": "music-fetch-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Music Fetch for Chromium and Firefox (desktop and Android)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b chrome && wxt zip -b firefox --mv3",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
