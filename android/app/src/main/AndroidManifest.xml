<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Provider apps that open links directly (Providers.packages, ServiceLinkOpener) and
         Google's hum to search. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.apple.android.music" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.qobuz.music" />
        <package android:name="com.pandora.android" />
        <package android:name="com.audiomack" />
        <package android:name="com.anghami" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.afmobi.boomplayer" />
        <package android:name="com.skysoft.kkbox.android" />
        <package android:name="ru.yandex.music" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.bandcamp.android" />
        <package android:name="com.shazam.android" />
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <!-- Backups stay off: restored Keystore-encrypted credentials could not be decrypted. -->
    <application
        android:name=".MusicFetchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicFetch"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- musicfetch://analyze?url=…, musicfetch://session/<id>, musicfetch://listen -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="musicfetch" />
            </intent-filter>
        </activity>

        <activity
            android:name=".share.ShareIdentifyActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.MusicFetch.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.TileTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.MusicFetch.Invisible" />

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <service
            android:name=".analysis.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <service
            android:name=".capture.SongTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/tile_song"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".capture.PhoneAudioTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile_phone"
            android:label="@string/tile_phone_audio"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- "Pin" on result notifications. -->
        <receiver
            android:name=".notify.PinReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ListenWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/listen_widget_info" />
        </receiver>

        <!-- Shares exported tracklists with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
